DATABASE_URL="postgresql://tami:tami@127.0.0.1:5434/tami"

# POI search: local Nominatim from docker-compose (required in production).
TAMI_NOMINATIM_BASE_URL="http://127.0.0.1:8090"

# Road routing: OSRM base URL (required in production).
# Defaults to the public demo server outside production.
# TAMI_ROUTING_BASE_URL="http://127.0.0.1:5000"

# Optional alternative geocoder; only used when TAMI_NOMINATIM_BASE_URL is unset.
# TAMI_MAPTILER_API_KEY=""

# Push notifications: legacy FCM HTTP API server key (required in production).
# Falls back to a development logger when unset outside production.
# TAMI_FCM_SERVER_KEY=""

# Redis: required in production for OTP rate limiting.
# Defaults to the local docker-compose service outside production.
TAMI_REDIS_URL="redis://127.0.0.1:6390"

# SMS delivery (Twilio placeholder — required in production).
# Falls back to a development logger when unset outside production.
# TAMI_TWILIO_ACCOUNT_SID=""
# TAMI_TWILIO_AUTH_TOKEN=""
# TAMI_TWILIO_FROM_NUMBER=""

# Admin command center shared token (required in production).
# TAMI_ADMIN_TOKEN=""

# Comma-separated origins allowed to call the API (leave empty in development).
# TAMI_CORS_ORIGINS=""

# Trust proxy setting for Express (required in production behind a load
# balancer/reverse proxy/ingress, otherwise per-IP rate limiting collapses
# onto the proxy's address). Set to the number of proxy hops in front of the
# API, e.g. "1" for a single load balancer, or "true"/"false" to match
# Express's trust proxy semantics directly.
# TAMI_TRUST_PROXY=""
