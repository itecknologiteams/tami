generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RideState {
  requested
  matching
  offered_to_driver
  accepted
  driver_en_route_to_pickup
  arrived_at_pickup
  rider_onboarded
  in_progress
  arrived_at_destination
  payment_pending
  completed
  cancelled_by_rider
  cancelled_by_driver
  cancelled_by_admin
  no_show
  driver_timeout
  payment_failed
  disputed
  incident_reported
}

enum RideCategoryCode {
  standard_taxi
  women_family_preferred
  airport
  accessible_special_assistance
  government_staff_movement
  scheduled_ride
}

enum PaymentMethod {
  cash
  jazzcash
  easypaisa
  nayapay
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  refunded
  disputed
}

enum ChatSenderType {
  rider
  driver
  admin
  system
}

enum SavedPlaceDesignation {
  home
  work
}

model City {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  province        String   @default("Sindh")
  active          Boolean  @default(true)
  centerLatitude  Decimal? @db.Decimal(9, 6)
  centerLongitude Decimal? @db.Decimal(9, 6)
  searchWest      Decimal? @db.Decimal(9, 6)
  searchSouth     Decimal? @db.Decimal(9, 6)
  searchEast      Decimal? @db.Decimal(9, 6)
  searchNorth     Decimal? @db.Decimal(9, 6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  zones        Zone[]
  riders       Rider[]
  drivers      Driver[]
  vehicles     Vehicle[]
  rides        Ride[]
  savedPlaces  SavedPlace[]
  farePolicies FarePolicy[]
}

model Zone {
  id        String   @id @default(cuid())
  cityId    String
  name      String
  slug      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city  City   @relation(fields: [cityId], references: [id])
  rides Ride[]

  @@unique([cityId, slug])
}

model RideCategory {
  id          String           @id @default(cuid())
  code        RideCategoryCode @unique
  name        String
  description String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rides Ride[]
}

model Rider {
  id          String   @id @default(cuid())
  cityId      String
  phone       String   @unique
  name        String?
  email       String?
  imageUrl    String?
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  city        City           @relation(fields: [cityId], references: [id])
  rides       Ride[]
  sessions    RiderSession[]
  savedPlaces SavedPlace[]
}

model SavedPlace {
  id          String                 @id @default(cuid())
  riderId     String
  cityId      String
  designation SavedPlaceDesignation?
  label       String
  address     String
  latitude    Decimal                @db.Decimal(9, 6)
  longitude   Decimal                @db.Decimal(9, 6)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  rider Rider @relation(fields: [riderId], references: [id])
  city  City  @relation(fields: [cityId], references: [id])

  @@unique([riderId, designation])
  @@index([riderId, createdAt])
}

model RiderSession {
  id         String    @id @default(cuid())
  riderId    String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
}

model Driver {
  id           String    @id @default(cuid())
  cityId       String
  phone        String    @unique
  name         String
  active       Boolean   @default(true)
  online       Boolean   @default(false)
  lastOnlineAt DateTime?
  latitude     Decimal?  @db.Decimal(9, 6)
  longitude    Decimal?  @db.Decimal(9, 6)
  deviceToken  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  city     City            @relation(fields: [cityId], references: [id])
  vehicles Vehicle[]
  rides    Ride[]
  sessions DriverSession[]

  @@index([cityId, online])
}

model DriverSession {
  id         String    @id @default(cuid())
  driverId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id        String   @id @default(cuid())
  cityId    String
  driverId  String?
  plateNo   String   @unique
  fleetNo   String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city   City    @relation(fields: [cityId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])
  rides  Ride[]
}

model FarePolicy {
  id                String   @id @default(cuid())
  cityId            String
  version           Int
  name              String
  active            Boolean  @default(false)
  currency          String   @default("PKR")
  baseFareMinor     Int
  perKilometerMinor Int
  perMinuteMinor    Int
  bookingFeeMinor   Int
  minimumFareMinor  Int
  demandMultiplier  Decimal  @db.Decimal(5, 2)
  maximumMultiplier Decimal  @db.Decimal(5, 2)
  maximumFareMinor  Int?
  roadFactor        Decimal  @db.Decimal(5, 2)
  averageSpeedKph   Int
  effectiveFrom     DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  city          City                     @relation(fields: [cityId], references: [id])
  categoryRates FarePolicyCategoryRate[]
  rides         Ride[]

  @@unique([cityId, version])
  @@index([cityId, active])
}

model FarePolicyCategoryRate {
  farePolicyId String
  categoryCode RideCategoryCode
  multiplier   Decimal          @db.Decimal(5, 2)

  farePolicy FarePolicy @relation(fields: [farePolicyId], references: [id], onDelete: Cascade)

  @@id([farePolicyId, categoryCode])
}

model Ride {
  id                   String    @id @default(cuid())
  idempotencyKey       String?
  cityId               String
  zoneId               String?
  riderId              String
  driverId             String?
  vehicleId            String?
  categoryId           String
  state                RideState @default(requested)
  pickupLatitude       Decimal   @db.Decimal(9, 6)
  pickupLongitude      Decimal   @db.Decimal(9, 6)
  pickupAddress        String
  destinationLatitude  Decimal   @db.Decimal(9, 6)
  destinationLongitude Decimal   @db.Decimal(9, 6)
  destinationAddress   String
  scheduledPickupAt    DateTime?
  estimatedFareMinor   Int?
  finalFareMinor       Int?
  currency             String    @default("PKR")
  farePolicyId         String?
  farePolicyVersion    Int?
  fareMultiplier       Decimal?  @db.Decimal(5, 2)
  routeDistanceMeters  Int?
  routeDurationSeconds Int?
  requestedAt          DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  city         City                  @relation(fields: [cityId], references: [id])
  zone         Zone?                 @relation(fields: [zoneId], references: [id])
  rider        Rider                 @relation(fields: [riderId], references: [id])
  driver       Driver?               @relation(fields: [driverId], references: [id])
  vehicle      Vehicle?              @relation(fields: [vehicleId], references: [id])
  category     RideCategory          @relation(fields: [categoryId], references: [id])
  transitions  RideStateTransition[]
  payments     PaymentRecord[]
  chatMessages ChatMessage[]
  farePolicy   FarePolicy?           @relation(fields: [farePolicyId], references: [id], onDelete: SetNull)

  @@unique([riderId, idempotencyKey])
}

model ChatMessage {
  id         String         @id @default(cuid())
  rideId     String
  senderType ChatSenderType
  senderId   String
  body       String
  sentAt     DateTime       @default(now())
  createdAt  DateTime       @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, sentAt])
}

model RideStateTransition {
  id         String     @id @default(cuid())
  rideId     String
  fromState  RideState?
  toState    RideState
  actorType  String
  actorId    String
  reason     String?
  latitude   Decimal?   @db.Decimal(9, 6)
  longitude  Decimal?   @db.Decimal(9, 6)
  source     String?
  occurredAt DateTime   @default(now())
  createdAt  DateTime   @default(now())

  ride Ride @relation(fields: [rideId], references: [id])
}

model PaymentRecord {
  id            String        @id @default(cuid())
  rideId        String
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  amountMinor   Int
  currency      String        @default("PKR")
  providerRef   String?
  collectedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ride Ride @relation(fields: [rideId], references: [id])
}
